# Runtime
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/tims_db?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=tims
DB_PASSWORD=change-me
DB_DRIVER=com.mysql.cj.jdbc.Driver
DDL_AUTO=validate
FLYWAY_ENABLED=true

# Security: use a random value of at least 32 bytes in every environment
JWT_SECRET=replace-with-a-random-256-bit-secret
ACCESS_TOKEN_TTL=PT15M
BOOTSTRAP_ADMIN_EMAIL=admin@institution.ac.ug
BOOTSTRAP_ADMIN_PASSWORD=replace-me

# Frontend origins, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000
